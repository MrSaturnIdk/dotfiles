runtime ftplugin/man.vim

syntax on
set number
set ruler

set backspace=indent,eol,start

set hlsearch
set incsearch

set tabstop=4
set shiftwidth=4
set expandtab
autocmd FileType make setlocal noexpandtab
set softtabstop=4
set autoindent

set nowrap

set colorcolumn=120
highlight ColorColumn ctermbg=215
